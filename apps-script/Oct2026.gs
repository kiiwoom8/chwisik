function octApply_() {
  var p = PropertiesService.getScriptProperties();
  if (p.getProperty('OCT_APPLY') === '1' || p.getProperty('OCT_IMPORT') !== '1') return;
  var res = withLock_(function () {
    // 취식 tags: only untagged October 폐기 lines
    var sh = itemsSheet_(), n = sh.getLastRow() - 1, tagged = 0, missing = [];
    if (n > 0) {
      var keys = sh.getRange(2, C.KEY, n, 1).getDisplayValues();
      var meta = sh.getRange(2, C.MONTH, n, C.SRC - C.MONTH + 1).getDisplayValues(); // 월, 확인, 전표
      var mp = sh.getRange(2, C.TYPE, n, 4).getValues();                             // 구분, 등록이름, 직원, 등록시각
      var at = {};
      keys.forEach(function (r, i) { at[r[0]] = i; });
      OCT_TAGS.forEach(function (t) {
        var i = at[t[0]];
        if (i === undefined) { missing.push(t[0]); return; }
        if (meta[i][0] !== '2026-10' || meta[i][2] !== '' || mp[i][0] !== '') return;
        mp[i] = ['취식', t[1], t[1], t[2]];
        tagged++;
      });
      if (tagged) sh.getRange(2, C.TYPE, n, 4).setValues(mp);
    }
    // 출근일지: skip a shift that overlaps one already recorded for that worker
    var ss = shiftSheet_(), all = readShifts_(), nowM = nowMin_(), rows = [], stamp = Utilities.formatDate(new Date(), TZ, 'MM/dd HH:mm');
    OCT_SHIFTS.forEach(function (s, i) {
      var sp = shiftSpan_({ date: s[0], start: s[2], end: s[3] });
      if (overlapOf_(all, s[1], sp[0], sp[1], '', nowM)) return;
      rows.push(['oct' + ('00' + i).slice(-3), s[0], s[1], s[2], s[3], shiftHours_(s[0], s[2], s[3]), '', stamp, s[0].slice(0, 7)]);
    });
    if (rows.length) ss.getRange(ss.getLastRow() + 1, 1, rows.length, SNCOL).setValues(rows);
    return { tagged: tagged, missing: missing, shifts: rows.length };
  });
  p.setProperty('OCT_APPLY', '1');
  bumpVersion_(true);
  logImport_('2026-10 (10월 취식·근무 넣기)', '', res.tagged, 'OK · 취식 ' + res.tagged + '/' + OCT_TAGS.length + '건, 근무 ' + res.shifts + '/' + OCT_SHIFTS.length + '건' +
    (res.missing.length ? ' · 못 찾은 키 ' + res.missing.length + '개: ' + res.missing.slice(0, 5).join(', ') : ''));
}

